{
  "name": "roboai-platform",
  "private": true,
  "version": "0.0.0",
  "description": "A visual programming IDE for teaching robotics and AI",
  "author": "RoboAI",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --force > vite_crash_log.txt 2>&1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.roboai.platform",
    "productName": "RoboAI",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "compile-server/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "compile-server/arduino-cli.exe",
        "to": "arduino-cli.exe"
      }
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "${productName}-${version}.exe"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@wokwi/elements": "^1.9.2",
    "avr8js": "^0.21.0",
    "blockly": "^12.4.1",
    "cors": "^2.8.5",
    "esptool-js": "^0.5.4",
    "express": "^4.19.2",
    "firebase": "^12.11.0",
    "intel-hex": "^0.2.0",
    "lucide-react": "^0.575.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-draggable": "^4.6.0",
    "vosk-browser": "^0.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/web-bluetooth": "^0.0.20",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wait-on": "^7.2.0"
  }
}
